# Copy to .env and edit.
DOMAIN=tracecds.com, www.tracecds.com
# Open-source model served by Ollama (all Apache-2.0):
#   qwen2.5:7b-instruct  (default; needs ~8 GB RAM)
#   olmo2:7b             (fully open: weights, data, and training code)
#   mistral:7b           (Mistral 7B v0.3)
#   qwen2.5:1.5b-instruct (lighter and faster on small servers; weaker summaries)
TRACECDS_MODEL=qwen2.5:7b-instruct
# Optional free key from https://open.fda.gov/apis/authentication/ (raises rate limits)
OPENFDA_API_KEY=
# Random secret for the internal SearXNG search service. Generate with: openssl rand -hex 32
SEARXNG_SECRET=
