# Copy to .env and edit.
# Marketing homepage (static) and the chat app each need their own A record
# pointing at the server's IP -- see deploy/SELF_HOSTING.md.
DOMAIN=tracecds.com, www.tracecds.com
CHAT_DOMAIN=chat.tracecds.com
# LLM backend for the "Written answer" mode. Any OpenAI-compatible endpoint works.
# Hosted API (fast) -- e.g. DeepInfra. NEVER commit a real key; keep it in a
# gitignored .env or an env file outside the repo.
TRACECDS_LLM_URL=https://api.deepinfra.com/v1/openai
TRACECDS_MODEL=nvidia/NVIDIA-Nemotron-3.5-Super-VL
TRACECDS_LLM_API_KEY=
# Self-hosted alternative (keeps generation on your own box, no API key):
#   TRACECDS_LLM_URL=http://localhost:11434/v1
#   TRACECDS_MODEL=qwen2.5:7b-instruct
# Optional free key from https://open.fda.gov/apis/authentication/ (raises rate limits)
OPENFDA_API_KEY=
# Random secret for the internal SearXNG search service. Generate with: openssl rand -hex 32
SEARXNG_SECRET=
